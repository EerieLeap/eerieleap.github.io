{
  "name": "eerieleap-website",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "The Eerie Leap web site, eerieleap.com",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test": "vitest run && tsx scripts/pseudo-locale.ts && astro build && playwright test",
    "i18n:status": "tsx scripts/i18n-status.ts",
    "i18n:pseudo": "tsx scripts/pseudo-locale.ts",
    "i18n:pseudo:remove": "tsx scripts/pseudo-locale.ts --remove",
    "licenses:update": "tsx scripts/update-licenses.ts",
    "stills": "tsx scripts/render-stills.ts",
    "marks": "tsx scripts/render-marks.ts",
    "shots": "tsx scripts/screenshots.ts"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.4",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/starlight": "^0.42.9",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.4",
    "astro": "^7.4.7",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@napi-rs/canvas": "^1.1.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "shiki": "^4.6.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
