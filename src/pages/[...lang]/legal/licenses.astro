---
import LegalHead from '@/components/layout/LegalHead.astro';
import { Rows } from '@/components/ui';
import { langOf, localePaths, locales } from '@/i18n';
import Marketing from '@/layouts/Marketing.astro';
import { copy } from '@/lib/content';
import { licenseOf } from '@/lib/firmware';

// Licenses. The firmware's are the ones its repositories had when the pins were last moved (firmware-docs.json).
export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang);
const page = await copy('licenses', lang);
const year = String(new Date().getFullYear());
const firmware = page.firmware.items.map((item) => ({ ...item, mark: licenseOf(item.name) }));
const site = page.site.items.map((item) => ({ ...item, text: item.text.replace('{year}', year) }));
---

<Marketing
  seo={{ title: page.title, description: page.description, path: '/legal/licenses/', lang, langs: locales }}
  band={false}
>
  <LegalHead crumbs={page.crumbs} title={page.heading} lead={page.lead} />
  <div class="wrap flex flex-col gap-14 pt-12 pb-24">
    <section>
      <h2 class="mb-[18px] text-[26px] font-semibold tracking-[-0.03em]">{page.firmware.title}</h2>
      <Rows items={firmware} lang={lang} />
    </section>
    <section>
      <h2 class="mb-[18px] text-[26px] font-semibold tracking-[-0.03em]">{page.site.title}</h2>
      <Rows items={site} lang={lang} />
    </section>
  </div>
</Marketing>
