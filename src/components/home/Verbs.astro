---
import type { Home } from '@/content/types';

interface Props {
  verbs: Home['verbs'];
}

const { verbs } = Astro.props;
---

<div class="flex flex-wrap gap-px border-y border-line bg-line">
  {verbs.map((verb) => (
    <div class="flex min-w-0 flex-[1_1_200px] flex-col gap-1.5 bg-ground px-[clamp(20px,2vw,28px)] pt-[22px] pb-6">
      <p class="text-2xl leading-[1.1] font-semibold tracking-[-0.03em]">{verb.title}</p>
      <p class="text-sm text-dim">{verb.text}</p>
    </div>
  ))}
</div>
