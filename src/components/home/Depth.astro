---
import { Section } from '@/components/ui';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import type { Home } from '@/content/types';
import { href } from '@/i18n';
import { LUA_EXAMPLE } from '@/lib/words';

interface Props {
  deep: Home['deep'];
  lang: string;
}

const { deep, lang } = Astro.props;
---

<Section id="deep" title={deep.title}>
  <div class="flex flex-wrap items-stretch gap-x-14 gap-y-9">
    <ol class="flex min-w-0 flex-[1_1_360px] flex-col border-b border-soft">
      {deep.steps.map((step, index) => (
        <li class="flex gap-[18px] border-t border-soft pt-[18px] pb-5">
          <span aria-hidden="true" class="label flex-[0_0_20px] leading-[26px] text-faint">
            {index + 1}
          </span>
          <div class="flex flex-col gap-1.5">
            <h3 class="h-item">{step.title}</h3>
            <p class="text-[14.5px] text-dim">{step.text}</p>
            {step.samples && (
              <p class="mt-1 flex flex-wrap gap-2 font-mono text-[11.5px] text-ink">
                {step.samples.map((sample) => (
                  <code class="border border-line px-3 py-2">{sample}</code>
                ))}
              </p>
            )}
            {step.more && (
              <a href={href(lang, '/firmware/')} class="label self-start pt-3 text-ink">
                {step.more}
              </a>
            )}
          </div>
        </li>
      ))}
    </ol>
    <div class="min-w-0 flex-[1.35_1_440px]">
      <CodeBlock title={deep.codeTitle} code={LUA_EXAMPLE} />
    </div>
  </div>
</Section>
