---
// Under a docs page: Starlight's own foot (edit link, last change, the page before and after), then the site's small print.
import Default from '@astrojs/starlight/components/Footer.astro';
import { href, langOf, useT } from '@/i18n';

const lang = langOf(Astro.locals.starlightRoute.locale);
const t = useT(lang);
const year = new Date().getFullYear();
---

<Default>
  <slot />
</Default>
<p class="small">
  <span>{t('footer.copyright', { year })}</span>
  <a href={href(lang, '/legal/privacy/')}>{t('footer.privacy')}</a>
  <a href={href(lang, '/legal/licenses/')}>{t('footer.licenses')}</a>
  <span>{t('footer.noCookies')}</span>
</p>

<script>
  // A table wider than the page scrolls sideways, and a thing that scrolls must be reachable by the keyboard.
  for (const table of document.querySelectorAll<HTMLTableElement>('.sl-markdown-content table')) {
    if (table.scrollWidth > table.clientWidth) table.tabIndex = 0;
  }
</script>

<style>
  .small {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 28px;
    margin-top: 2.5rem;
    padding-top: 18px;
    border-top: 1px solid var(--line-soft);
    font-family: var(--font-label);
    font-size: 10.5px;
    color: var(--text-faint);
  }
  .small a {
    color: inherit;
    text-decoration: none;
  }
  .small a:hover {
    color: var(--pip);
  }
</style>
