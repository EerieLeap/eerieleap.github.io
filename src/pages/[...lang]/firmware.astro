---
import { Button, Cells, PageHead, Rows, Section } from '@/components/ui';
import CodeBlock from '@/components/ui/CodeBlock.astro';
import { href, langOf, localePaths, locales } from '@/i18n';
import Marketing from '@/layouts/Marketing.astro';
import { copy } from '@/lib/content';
import { licenseOf } from '@/lib/firmware';
import { organization } from '@/lib/seo';
import { DISCUSSIONS, GITHUB, repo } from '@/lib/site';
import { LUA_EXAMPLE } from '@/lib/words';

// The Firmware page. Each repository's license is what firmware.json says of it; the user docs are the site's own and
// the developer reference stays with the code.
export const getStaticPaths = localePaths;

const lang = langOf(Astro.params.lang);
const page = await copy('firmware', lang);

const repositories = page.repositories.items.map((item) => ({ ...item, mark: licenseOf(item.name) }));
const docsWays = { docs: '/docs/', reference: `${repo('rt_core')}/tree/main/docs` };
const docs = page.docs.items.map((item) => ({
  title: item.title,
  text: item.text,
  more: { label: item.more, to: docsWays[item.to] },
}));
const ways = { issues: `${repo('rt_core')}/issues`, code: GITHUB, discussions: DISCUSSIONS };
const part = page.part.items.map((item) => ({
  title: item.title,
  text: item.text,
  more: { label: item.more, to: ways[item.to] },
}));
---

<Marketing
  seo={{
    title: page.title,
    description: page.description,
    path: '/firmware/',
    lang,
    langs: locales,
    jsonLd: [
      {
        '@type': 'SoftwareSourceCode',
        name: 'Eerie Leap firmware',
        codeRepository: repo('rt_core'),
        license: 'https://www.apache.org/licenses/LICENSE-2.0',
        programmingLanguage: 'C++',
        author: { '@id': organization['@id'] },
      },
    ],
  }}
  active="nav.firmware"
>
  <PageHead crumbs={page.crumbs} title={page.heading} lead={page.lead} wide>
    <Fragment slot="actions">
      <Button href={href(lang, '/docs/')}>{page.actions.docs}</Button>
      <Button href={GITHUB} secondary>
        {page.actions.github}
      </Button>
    </Fragment>
    <CodeBlock slot="aside" title={page.codeTitle} code={LUA_EXAMPLE} />
  </PageHead>
  <Section title={page.does.title}>
    <Cells items={page.does.items} lang={lang} min={200} />
  </Section>
  <Section title={page.runs.title}>
    <Cells items={page.runs.items} lang={lang} />
  </Section>
  <Section title={page.repositories.title} lead={page.repositories.lead}>
    <Rows items={repositories} lang={lang} />
  </Section>
  <Section title={page.docs.title} lead={page.docs.lead}>
    <Cells items={docs} lang={lang} />
  </Section>
  <Section title={page.part.title} tight>
    <Cells items={part} lang={lang} />
  </Section>
</Marketing>
