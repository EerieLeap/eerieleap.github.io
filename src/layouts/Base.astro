---
import archivo from '@fontsource-variable/archivo/files/archivo-latin-wght-normal.woff2?url';
import SkipLink from '@/components/layout/SkipLink.astro';
import { tagOf, useT } from '@/i18n';
import { headOf, type Seo } from '@/lib/seo';
import { ANALYTICS_TOKEN } from '@/lib/env';
import '@/styles/global.css';

interface Props {
  seo: Seo;
  /** For a page that places the skip link itself, once in each of its language blocks (the 404 page). */
  ownSkip?: boolean;
}

const { seo, ownSkip = false } = Astro.props;
const head = headOf(seo);
const t = useT(seo.lang);
---

<!doctype html>
<html lang={tagOf(seo.lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{head.title}</title>
    <meta name="description" content={head.description} />
    <link rel="canonical" href={head.canonical} />
    {head.alternates.map((alternate) => (
      <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
    ))}
    {head.noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0C0C0C" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preload" href={archivo} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={t('site.name')} />
    <meta property="og:title" content={head.title} />
    <meta property="og:description" content={head.description} />
    <meta property="og:url" content={head.canonical} />
    <meta property="og:locale" content={head.locale} />
    <meta property="og:image" content={head.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {head.jsonLd.map((data) => (
      <script type="application/ld+json" set:html={data} />
    ))}
    {ANALYTICS_TOKEN && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: ANALYTICS_TOKEN })}
      />
    )}
  </head>
  <body class="bg-ground font-sans text-ink antialiased">
    {!ownSkip && <SkipLink lang={seo.lang} />}
    <slot />
  </body>
</html>
